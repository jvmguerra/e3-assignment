    "diff": "^8.0.4",
    "dotenv": "^17.4.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.4.1",
